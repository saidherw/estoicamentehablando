# Reglas de Cabeceras HTTP de Seguridad para Netlify
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://identity.netlify.com https://unpkg.com https://www.youtube.com https://s.ytimg.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://identity.netlify.com; connect-src 'self' https://api.github.com https://identity.netlify.com https://www.google-analytics.com; object-src 'none';

# Permitir Frames para el panel de administración
/admin/*
  X-Frame-Options: SAMEORIGIN
  X-Robots-Tag: noindex, nofollow

# Caché Inmutable para Archivos Estáticos
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
